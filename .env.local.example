# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never expose to the browser. Used only in trusted server
# contexts (e.g. an admin action or a scheduled job), never in a route
# that runs on behalf of an arbitrary request.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: show sample hotel/homestay listings on the homepage and
# browse pages without any Supabase setup at all — no project, no seed
# script, no signup. Only affects read-only listing display; booking,
# auth, and My Trips still need a real Supabase project. Turn this off
# (or remove it) once your own listings are live.
NEXT_PUBLIC_DEMO_MODE=true

# Optional: sends a booking confirmation email via Resend (resend.com)
# after a booking is created. Without it, booking still works normally —
# the email send is just skipped. Get a key at resend.com/api-keys.
# RESEND_FROM_EMAIL can stay unset while testing — onboarding@resend.dev
# works without verifying your own domain, but only for now.
RESEND_API_KEY=
RESEND_FROM_EMAIL=DheySa <onboarding@resend.dev>
